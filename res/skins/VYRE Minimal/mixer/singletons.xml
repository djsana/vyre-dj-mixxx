<!DOCTYPE template>
<Template>
  <SetVariable name="ChannelType">channel</SetVariable>
  <SetVariable name="VuSize">deck</SetVariable>
  <SetVariable name="VuColor">dark</SetVariable>

  <SingletonDefinition>
    <ObjectName>CrossfaderSingleton</ObjectName>
    <Children>
      <WidgetGroup>
        <Size>132f,44f</Size>
        <Children>
          <WidgetGroup>
            <Size>132f,44f</Size>
            <ObjectName>CrossfaderContainer</ObjectName>
            <Children>
              <SliderComposed>
                <TooltipId>crossfader</TooltipId>
                <Size>132f,44f</Size>
                <Handle scalemode="STRETCH_ASPECT">skins:LateNight/<Variable name="SliderScheme"/>/sliders/knob_crossfader.svg</Handle>
                <Slider visible="false" scalemode="STRETCH_ASPECT">skins:LateNight/<Variable name="SliderScheme"/>/sliders/slider_crossfader.svg</Slider>
                <Horizontal>true</Horizontal>
                <BarColor><Variable name="BarColorCrossfader"/></BarColor>
                <BarWidth>3</BarWidth>
                <BarMargins><Variable name="BarMarginCrossfader"/></BarMargins>
                <BarRoundCaps>true</BarRoundCaps>
                <BarAxisPos>21.0</BarAxisPos>
                <BarUnipolar>false</BarUnipolar>
                <Connection><ConfigKey>[Master],crossfader</ConfigKey></Connection>
              </SliderComposed>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
    </Children>
  </SingletonDefinition>

  <SingletonDefinition>
    <ObjectName>VuMeterChannel1</ObjectName>
    <Children><WidgetGroup><Layout>horizontal</Layout><Children><Template src="skins:LateNight/mixer/vumeter_single.xml"><SetVariable name="Group">[Channel1]</SetVariable></Template></Children></WidgetGroup></Children>
  </SingletonDefinition>
  <SingletonDefinition>
    <ObjectName>VuMeterChannel2</ObjectName>
    <Children><WidgetGroup><Layout>horizontal</Layout><Children><Template src="skins:LateNight/mixer/vumeter_single.xml"><SetVariable name="Group">[Channel2]</SetVariable></Template></Children></WidgetGroup></Children>
  </SingletonDefinition>
  <SingletonDefinition>
    <ObjectName>VuMeterMain_Dark</ObjectName>
    <Children><WidgetGroup><Layout>horizontal</Layout><Children><Template src="skins:LateNight/mixer/vumeter_main.xml"><SetVariable name="VuColor">dark</SetVariable></Template></Children></WidgetGroup></Children>
  </SingletonDefinition>
  <SingletonDefinition>
    <ObjectName>VuMeterMain_Light</ObjectName>
    <Children><WidgetGroup><Layout>horizontal</Layout><Children><Template src="skins:LateNight/mixer/vumeter_main.xml"><SetVariable name="VuColor">light</SetVariable></Template></Children></WidgetGroup></Children>
  </SingletonDefinition>
</Template>
