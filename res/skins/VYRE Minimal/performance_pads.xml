<Template>
  <WidgetGroup>
    <ObjectName>VyrePads</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>
      <WidgetGroup>
        <ObjectName>VyreStemPads</ObjectName>
        <Layout>horizontal</Layout>
        <Children>
          <Label><ObjectName>VyreStemLabel</ObjectName><Text>STEM FOCUS</Text><Size>92f,40f</Size><Alignment>center</Alignment></Label>
          <PushButton><Tooltip>Focus vocals using lightweight mid/side processing</Tooltip><ObjectName>VyrePadVocal</ObjectName><Size>me,40f</Size><NumberStates>2</NumberStates><State><Number>0</Number><Text>VOCALS</Text><Alignment>center</Alignment></State><State><Number>1</Number><Text>VOCALS FOCUSED</Text><Alignment>center</Alignment></State><Connection><ConfigKey><Variable name="Group"/>,stem_vocals</ConfigKey><ButtonState>LeftButton</ButtonState></Connection></PushButton>
          <PushButton><Tooltip>Focus the instrumental using lightweight mid/side processing</Tooltip><ObjectName>VyrePadInstrumental</ObjectName><Size>me,40f</Size><NumberStates>2</NumberStates><State><Number>0</Number><Text>INSTRUMENTAL</Text><Alignment>center</Alignment></State><State><Number>1</Number><Text>INSTRUMENTAL FOCUSED</Text><Alignment>center</Alignment></State><Connection><ConfigKey><Variable name="Group"/>,stem_instrumental</ConfigKey><ButtonState>LeftButton</ButtonState></Connection></PushButton>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <Children>
          <PushButton><TooltipId>beatloop_1_toggle</TooltipId><ObjectName>VyrePadLoop</ObjectName><Size>me,40f</Size><NumberStates>2</NumberStates><State><Number>0</Number><Text>LOOP 1</Text><Alignment>center</Alignment></State><State><Number>1</Number><Text>1 ACTIVE</Text><Alignment>center</Alignment></State><Connection><ConfigKey><Variable name="Group"/>,beatloop_1_toggle</ConfigKey><ButtonState>LeftButton</ButtonState></Connection></PushButton>
          <PushButton><TooltipId>beatloop_2_toggle</TooltipId><ObjectName>VyrePadLoop</ObjectName><Size>me,40f</Size><NumberStates>2</NumberStates><State><Number>0</Number><Text>LOOP 2</Text><Alignment>center</Alignment></State><State><Number>1</Number><Text>2 ACTIVE</Text><Alignment>center</Alignment></State><Connection><ConfigKey><Variable name="Group"/>,beatloop_2_toggle</ConfigKey><ButtonState>LeftButton</ButtonState></Connection></PushButton>
          <PushButton><TooltipId>beatloop_4_toggle</TooltipId><ObjectName>VyrePadLoop</ObjectName><Size>me,40f</Size><NumberStates>2</NumberStates><State><Number>0</Number><Text>LOOP 4</Text><Alignment>center</Alignment></State><State><Number>1</Number><Text>4 ACTIVE</Text><Alignment>center</Alignment></State><Connection><ConfigKey><Variable name="Group"/>,beatloop_4_toggle</ConfigKey><ButtonState>LeftButton</ButtonState></Connection></PushButton>
          <PushButton><TooltipId>beatloop_8_toggle</TooltipId><ObjectName>VyrePadLoop</ObjectName><Size>me,40f</Size><NumberStates>2</NumberStates><State><Number>0</Number><Text>LOOP 8</Text><Alignment>center</Alignment></State><State><Number>1</Number><Text>8 ACTIVE</Text><Alignment>center</Alignment></State><Connection><ConfigKey><Variable name="Group"/>,beatloop_8_toggle</ConfigKey><ButtonState>LeftButton</ButtonState></Connection></PushButton>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <Layout>horizontal</Layout>
        <Children>
          <PushButton><TooltipId>loop_in</TooltipId><ObjectName>VyrePadIn</ObjectName><Size>me,40f</Size><NumberStates>1</NumberStates><State><Number>0</Number><Text>SET IN</Text><Alignment>center</Alignment></State><Connection><ConfigKey><Variable name="Group"/>,loop_in</ConfigKey></Connection></PushButton>
          <PushButton><TooltipId>loop_out</TooltipId><ObjectName>VyrePadOut</ObjectName><Size>me,40f</Size><NumberStates>1</NumberStates><State><Number>0</Number><Text>SET OUT</Text><Alignment>center</Alignment></State><Connection><ConfigKey><Variable name="Group"/>,loop_out</ConfigKey></Connection></PushButton>
          <PushButton><TooltipId>reloop_toggle</TooltipId><ObjectName>VyrePadReloop</ObjectName><Size>me,40f</Size><NumberStates>2</NumberStates><State><Number>0</Number><Text>RELOOP</Text><Alignment>center</Alignment></State><State><Number>1</Number><Text>EXIT LOOP</Text><Alignment>center</Alignment></State><Connection><ConfigKey><Variable name="Group"/>,reloop_toggle</ConfigKey><ButtonState>LeftButton</ButtonState></Connection></PushButton>
          <PushButton><TooltipId>beatlooproll_4_activate</TooltipId><ObjectName>VyrePadRoll</ObjectName><Size>me,40f</Size><NumberStates>1</NumberStates><State><Number>0</Number><Text>ROLL 4</Text><Alignment>center</Alignment></State><Connection><ConfigKey><Variable name="Group"/>,beatlooproll_4_activate</ConfigKey></Connection></PushButton>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
