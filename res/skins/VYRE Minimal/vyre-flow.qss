/* VYRE Performance Console: direct, balanced and readable at a glance. */
#SkinContainer { background: #080c11; }

#VyreTopBar {
  min-height: 44px; max-height: 44px; padding: 4px 12px;
  background: #101720; border-bottom: 1px solid #263442;
}
#VyreBrand { image: url(skins:VYRE Minimal/vyre-dj-logo.svg); margin-right: 14px; }

#VyreMode, #VyreFocusCaption, #VyreTabHint, #VyreLibraryModeLabel,
#VyreStageLabelA, #VyreStageLabelB, #VyreMixerLabel, #VyreStemLabel {
  color: #8fa0b1; font-family: "Segoe UI Semibold", "Open Sans Semibold", "Open Sans";
  font-size: 11px; font-weight: 600;
}
#VyreStageLabelA, #VyreStageLabelB {
  padding-left: 10px; background: #151e28; border-bottom: 1px solid #2a3947;
}
#VyreStageLabelA { color: #63e6d2; }
#VyreStageLabelB { color: #aa9eff; }

WPushButton#VyreFocusButton, WPushButton#VyreViewButton, WPushButton#VyreLibraryButton {
  color: #c8d3dc; background: #1a2530; border: 1px solid #344655;
  border-radius: 5px; border-image: none; image: none; margin: 2px 3px;
  font-family: "Segoe UI Semibold", "Open Sans Semibold", "Open Sans"; font-weight: 600;
}
WPushButton#VyreFocusButton:hover, WPushButton#VyreViewButton:hover,
WPushButton#VyreLibraryButton:hover {
  color: #ffffff; background: #263644; border-color: #526779;
}
WPushButton#VyreFocusButton:pressed, WPushButton#VyreViewButton:pressed,
WPushButton#VyreLibraryButton:pressed {
  background: #0e151c; border-color: #63e6d2;
}
WPushButton#VyreFocusButton[displayValue="1"] {
  color: #07110f; background: #63e6d2; border-color: #63e6d2;
}

#VyreWaveformHorizon { background: #080c11; border-bottom: 1px solid #27333f; padding: 5px 8px; }
#VyreWaveforms, #VyreWaveformA, #VyreWaveformB { background: #090e13; }
#VyreWaveformA[highlight="1"] { border-left: 3px solid #42d7c5; }
#VyreWaveformB[highlight="1"] { border-left: 3px solid #8d7cff; }

#VyreWorksurface { background: #0a0f15; padding: 7px 8px 6px 8px; }
#VyrePerformanceRow { background: #0a0f15; }
#DeckRows12345, #DeckRows234 { background: #10171f; }
#VyreDeckColumnA, #VyreDeckColumnB {
  background: #10171f; border: 1px solid #27333e; border-radius: 6px;
}
#VyreDeckColumnA[highlight="1"] { border: 2px solid #42d7c5; }
#VyreDeckColumnB[highlight="1"] { border: 2px solid #8d7cff; }

#VyreMixDock {
  min-width: 250px; max-width: 284px; margin: 0px 7px; padding: 0px 4px;
  background: #111820; border: 1px solid #2b3743; border-radius: 6px;
}
#VyreCenterMixer, #MixerContainer, #MixerDecks { background: #111820; }
#VyreMixerLabel {
  color: #dbe6ee; background: #151e28; border-bottom: 1px solid #2a3947;
}

#SpinnyCoverContainer_Big {
  min-width: 180px; max-width: 180px; min-height: 180px; max-height: 180px;
  margin: 3px 10px 2px 6px; padding: 0px;
  background: #10171f; border: none;
}
#VyreJogShell, #VyreJogWheel {
  min-width: 176px; max-width: 176px; min-height: 176px; max-height: 176px;
  background-color: #10171f; border: none;
}

#VyreTransport {
  min-height: 48px; max-height: 48px; padding: 2px 4px;
  background: #0c1218; border-top: 1px solid #263541;
}
#VyreTransportCue, #VyreTransportPlay, #VyreTransportSync {
  min-height: 42px; max-height: 42px; margin: 1px 3px;
  color: #d7e2e9; background: #192530; border: 1px solid #3b4f5e;
  border-radius: 6px; border-image: none; image: none;
  font-family: "Segoe UI Semibold", "Open Sans Semibold", "Open Sans";
  font-size: 12px; font-weight: 600;
}
#VyreTransportCue:hover, #VyreTransportPlay:hover, #VyreTransportSync:hover {
  color: #ffffff; background: #263744; border-color: #687d8c;
}
#VyreTransportCue:pressed, #VyreTransportPlay:pressed, #VyreTransportSync:pressed {
  background: #0d151c; border-color: #e7eef3;
}
#VyreTransportCue[displayValue="1"] {
  color: #1b1004; background: #ffb45c; border-color: #ffd09a;
}
#VyreTransportPlay[displayValue="1"] {
  color: #061311; background: #55d8c4; border-color: #83f0df;
}
#VyreTransportSync[displayValue="1"] {
  color: #0d0a1a; background: #9d91ff; border-color: #c0b9ff;
}

#VyrePads {
  margin: 5px; padding: 5px; background: #0c1218;
  border-top: 1px solid #25313c;
}
#VyreStemPads { min-height: 40px; margin-bottom: 4px; }
#VyreStemLabel {
  color: #9babb8; background: #111a22; border: 1px solid #30414e; border-radius: 5px;
}

#VyrePadLoop, #VyrePadIn, #VyrePadOut, #VyrePadReloop, #VyrePadRoll,
#VyrePadVocal, #VyrePadInstrumental {
  min-height: 38px; max-height: 38px;
  color: #cdd7de; background-color: #18232d; border: 1px solid #344956;
  border-radius: 5px; border-image: none; image: none; margin: 2px; padding: 0px 8px;
  font-family: "Segoe UI Semibold", "Open Sans Semibold", "Open Sans";
  font-size: 11px; font-weight: 600;
}

#VyrePadLoop:hover, #VyrePadIn:hover, #VyrePadOut:hover, #VyrePadReloop:hover,
#VyrePadRoll:hover, #VyrePadVocal:hover, #VyrePadInstrumental:hover {
  color: #ffffff; background: #263744; border-color: #587083;
}
#VyrePadLoop:pressed, #VyrePadIn:pressed, #VyrePadOut:pressed,
#VyrePadReloop:pressed, #VyrePadRoll:pressed, #VyrePadVocal:pressed,
#VyrePadInstrumental:pressed {
  background: #0e161d; border-color: #63e6d2;
}
#VyrePadLoop[displayValue="1"], #VyrePadIn:pressed, #VyrePadOut:pressed,
#VyrePadReloop[displayValue="1"], #VyrePadRoll:pressed, #VyrePadVocal[displayValue="1"] {
  color: #061311; background: #55d8c4; border-color: #72efdc;
}
#VyrePadInstrumental[displayValue="1"] {
  color: #0d0b18; background: #9d91ff; border-color: #bbb3ff;
}

#VyreEffectShelf {
  margin-top: 5px; background: #10171f;
  border-top: 1px solid #27333e; border-bottom: 1px solid #27333e;
}
#VyreLibraryMode { background: #0a0f15; padding: 8px; }
#VyreLibraryModeLabel {
  padding-left: 10px; color: #bac7d3; background: #151e27;
  border-bottom: 1px solid #27333e;
}
#VyreWorkspaceSplitter::handle { background: #2a3743; height: 2px; }
